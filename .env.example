# Supabase Configuration - Transaction pooler with pgbouncer mode
# IMPORTANT: Never commit actual credentials to git
# Set these in your hosting platform's environment variables
DATABASE_URL="postgresql://user:password@host:5432/database?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:6543/database"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# NextAuth Configuration
NEXTAUTH_URL="https://your-production-url.com"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate_a_secure_random_secret_here"

# Vercel Blob Configuration
BLOB_READ_WRITE_TOKEN="your_blob_token_here"

# AWS S3 Configuration
AWS_ACCESS_KEY_ID="your_aws_access_key_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key_here"
AWS_REGION="ap-south-2"
AWS_S3_BUCKET_NAME="your-bucket-name"

# Postmark Email Configuration
POSTMARK_SERVER_TOKEN="your_postmark_token_here"
POSTMARK_ADMIN_EMAIL="admin@yourdomain.com"
POSTMARK_ADMIN_NAME="Your Company Admin"
POSTMARK_SUPPORT_EMAIL="support@yourdomain.com"
POSTMARK_SUPPORT_NAME="Your Company Support"
POSTMARK_NOREPLY_EMAIL="noreply@yourdomain.com"
POSTMARK_NOREPLY_NAME="Your Company System"

# Email Notification Recipients
CASE_NOTIFICATION_EMAIL="info@yourdomain.com"
ACCOUNT_NOTIFICATION_EMAIL="support@yourdomain.com"

# Default Email Settings (for backward compatibility)
FROM_EMAIL="support@yourdomain.com"
FROM_NAME="Your Company Support"
