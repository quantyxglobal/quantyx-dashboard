# Firebase Production Environment Variables for Dashboard
# IMPORTANT: Never commit actual secrets to git!
# Use Google Cloud Console or Secret Manager for sensitive values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL="postgresql://postgres.wghvermnyvppsgshgbmu:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.wghvermnyvppsgshgbmu:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://wghvermnyvppsgshgbmu.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ============================================================================
# NEXTAUTH CONFIGURATION
# ============================================================================
NEXTAUTH_URL="https://dashboard.quantyxg.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ============================================================================
# AWS S3 CONFIGURATION
# ============================================================================
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="ap-south-2"
AWS_S3_BUCKET_NAME="quantyx-global"

# ============================================================================
# POSTMARK EMAIL CONFIGURATION
# ============================================================================
POSTMARK_SERVER_TOKEN="your-postmark-token"
POSTMARK_ADMIN_EMAIL="admin@quantyxg.com"
POSTMARK_ADMIN_NAME="Quantyx Global Admin"
POSTMARK_SUPPORT_EMAIL="support@quantyxg.com"
POSTMARK_SUPPORT_NAME="Quantyx Global Support"
POSTMARK_NOREPLY_EMAIL="noreply@quantyxg.com"
POSTMARK_NOREPLY_NAME="Quantyx Global System"

# ============================================================================
# EMAIL NOTIFICATION RECIPIENTS
# ============================================================================
CASE_NOTIFICATION_EMAIL="info@quantyxg.com"
ACCOUNT_NOTIFICATION_EMAIL="support@quantyxg.com"
FROM_EMAIL="support@quantyxg.com"
FROM_NAME="Quantyx Global Support"

# ============================================================================
# FIREBASE/GOOGLE CLOUD SPECIFIC
# ============================================================================
GOOGLE_CLOUD_PROJECT="quantyx-global"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"

# ============================================================================
# FEATURE FLAGS
# ============================================================================
NEXT_PUBLIC_ENABLE_MFA=true
NEXT_PUBLIC_ENABLE_AUDIT_LOGS=true
NEXT_PUBLIC_ENABLE_FILE_ENCRYPTION=true

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
SENTRY_DSN="https://your-sentry-dsn"

# ============================================================================
# CUSTOM DOMAIN (Route53)
# ============================================================================
NEXT_PUBLIC_DOMAIN="dashboard.quantyxg.com"
NEXT_PUBLIC_WEBSITE_URL="https://quantyxg.com"
