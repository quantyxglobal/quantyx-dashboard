# Production environment variables
# These map Amplify-safe variable names to the ones the app expects

# Map AMPLIFY_AWS_* to AWS_* for the application
AWS_ACCESS_KEY_ID=${AMPLIFY_AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AMPLIFY_AWS_SECRET_ACCESS_KEY}
AWS_REGION=${AMPLIFY_AWS_REGION}
AWS_S3_BUCKET_NAME=${AMPLIFY_AWS_S3_BUCKET_NAME}
